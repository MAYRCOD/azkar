{"n":88,"ayahs":[{"ar":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ١","ru":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?","page":592,"juz":30},{"ar":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ ٢","ru":"Одни лица в тот день будут унижены,","page":592,"juz":30},{"ar":"عَامِلَةٞ نَّاصِبَةٞ ٣","ru":"изнурены и утомлены.","page":592,"juz":30},{"ar":"تَصۡلَىٰ نَارًا حَامِيَةٗ ٤","ru":"Они войдут в Огонь жаркий.","page":592,"juz":30},{"ar":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ ٥","ru":"Их будут поить из источника кипящего","page":592,"juz":30},{"ar":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦","ru":"и кормить только ядовитыми колючками,","page":592,"juz":30},{"ar":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ ٧","ru":"от которых не поправляются и которые не утоляют голода.","page":592,"juz":30},{"ar":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ ٨","ru":"Другие же лица в тот день будут радостны.","page":592,"juz":30},{"ar":"لِّسَعۡيِهَا رَاضِيَةٞ ٩","ru":"Они будут довольны своими стараниями","page":592,"juz":30},{"ar":"فِي جَنَّةٍ عَالِيَةٖ ١٠","ru":"в Вышних садах.","page":592,"juz":30},{"ar":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ ١١","ru":"Они не услышат там словоблудия.","page":592,"juz":30},{"ar":"فِيهَا عَيۡنٞ جَارِيَةٞ ١٢","ru":"Там есть источник текущий.","page":592,"juz":30},{"ar":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ ١٣","ru":"Там воздвигнуты ложа,","page":592,"juz":30},{"ar":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ ١٤","ru":"расставлены чаши,","page":592,"juz":30},{"ar":"وَنَمَارِقُ مَصۡفُوفَةٞ ١٥","ru":"разложены подушки,","page":592,"juz":30},{"ar":"وَزَرَابِيُّ مَبۡثُوثَةٌ ١٦","ru":"и разостланы ковры.","page":592,"juz":30},{"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ١٧","ru":"Неужели они не видят, как созданы верблюды,","page":592,"juz":30},{"ar":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ١٨","ru":"как вознесено небо,","page":592,"juz":30},{"ar":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ١٩","ru":"как водружены горы,","page":592,"juz":30},{"ar":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ٢٠","ru":"как распростерта земля?","page":592,"juz":30},{"ar":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ ٢١","ru":"Наставляй же, ведь ты - наставник,","page":592,"juz":30},{"ar":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ ٢٢","ru":"и ты не властен над ними.","page":592,"juz":30},{"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ٢٣","ru":"А тех, кто отвернется и не уверует,","page":593,"juz":30},{"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ٢٤","ru":"Аллах подвергнет величайшим мучениям.","page":593,"juz":30},{"ar":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ٢٥","ru":"К Нам они вернутся,","page":593,"juz":30},{"ar":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ٢٦","ru":"и затем Мы потребуем у них отчета.","page":593,"juz":30}]}