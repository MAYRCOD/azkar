{"n":113,"ayahs":[{"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ ١","ru":"Скажи: «Прибегаю к защите Господа рассвета","page":604,"lines":[7,7],"juz":30},{"ar":"مِن شَرِّ مَا خَلَقَ ٢","ru":"от зла того, что Он сотворил,","page":604,"lines":[7,7],"juz":30},{"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ٣","ru":"от зла мрака, когда он наступает,","page":604,"lines":[7,8],"juz":30},{"ar":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ ٤","ru":"от зла колдуний, поплевывающих на узлы,","page":604,"lines":[8,8],"juz":30},{"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ ٥","ru":"от зла завистника, когда он завидует».","page":604,"lines":[9,9],"juz":30}]}