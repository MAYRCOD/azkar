{
 "n": 94,
 "ayahs": [
  {
   "ar": "أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ ١",
   "ru": "Разве Мы не раскрыли для тебя грудь твою?",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَوَضَعۡنَا عَنكَ وِزۡرَكَ ٢",
   "ru": "и не сняли с тебя ношу,",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ ٣",
   "ru": "которая отягощала твою спину?",
   "page": 597,
   "juz": 30
  },
  {
   "ar": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ ٤",
   "ru": "Разве Мы не возвеличили для тебя славу твою?",
   "page": 597,
   "juz": 30
  },
  {
   "ar": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ٥",
   "ru": "Воистину, за каждой тягостью наступает облегчение.",
   "page": 597,
   "juz": 30
  },
  {
   "ar": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا ٦",
   "ru": "За каждой тягостью наступает облегчение.",
   "page": 597,
   "juz": 30
  },
  {
   "ar": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ ٧",
   "ru": "Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)",
   "page": 597,
   "juz": 30
  },
  {
   "ar": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب ٨",
   "ru": "и устремись к своему Господу.",
   "page": 597,
   "juz": 30
  }
 ]
