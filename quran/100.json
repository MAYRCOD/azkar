{"n":100,"ayahs":[{"ar":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا ١","ru":"Клянусь скачущими, запыхаясь!","page":599,"juz":30},{"ar":"فَٱلۡمُورِيَٰتِ قَدۡحٗا ٢","ru":"Клянусь высекающими искры копытами!","page":599,"juz":30},{"ar":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا ٣","ru":"Клянусь нападающими на заре!","page":599,"juz":30},{"ar":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا ٤","ru":"Тем самым они поднимают столб пыли","page":599,"juz":30},{"ar":"فَوَسَطۡنَ بِهِۦ جَمۡعًا ٥","ru":"и врываются с ним (со столбом пыли или с всадником) в гущу.","page":599,"juz":30},{"ar":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦","ru":"Воистину, человек неблагодарен своему Господу,","page":599,"juz":30},{"ar":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧","ru":"и он сам является тому свидетелем.","page":599,"juz":30},{"ar":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ ٨","ru":"Воистину, он страстно любит блага.","page":599,"juz":30},{"ar":"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ ٩","ru":"Неужели он не знает, что, когда будет опрокинуто то, что в могилах,","page":599,"juz":30},{"ar":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ ١٠","ru":"и когда обнаружится то, что в груди,","page":600,"juz":30},{"ar":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ ١١","ru":"в тот день Господь их будет осведомлен о них?","page":600,"juz":30}]}