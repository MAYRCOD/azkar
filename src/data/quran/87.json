{
 "n": 87,
 "ayahs": [
  {
   "ar": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى ١",
   "ru": "Славь имя Господа твоего Всевышнего,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "ٱلَّذِي خَلَقَ فَسَوَّىٰ ٢",
   "ru": "Который сотворил все сущее и всему придал соразмерность,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ ٣",
   "ru": "Который предопределил судьбу творений и указал путь,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ ٤",
   "ru": "Который взрастил пастбища,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ ٥",
   "ru": "а потом превратил их в темный сор.",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ ٦",
   "ru": "Мы позволим тебе прочесть Коран, и ты не забудешь ничего,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ ٧",
   "ru": "кроме того, что пожелает Аллах. Он знает явное и то, что сокрыто.",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ ٨",
   "ru": "Мы облегчим тебе путь к легчайшему.",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ ٩",
   "ru": "Наставляй же людей, если напоминание принесет пользу.",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "سَيَذَّكَّرُ مَن يَخۡشَىٰ ١٠",
   "ru": "Воспримет его тот, кто страшится,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى ١١",
   "ru": "и уклонится от него самый несчастный,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ ١٢",
   "ru": "который войдет в Огонь величайший.",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ ١٣",
   "ru": "Не умрет он там и не будет жить.",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ ١٤",
   "ru": "Преуспел тот, кто очистился,",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ ١٥",
   "ru": "поминал имя своего Господа и совершал намаз.",
   "page": 591,
   "juz": 30
  },
  {
   "ar": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ١٦",
   "ru": "Но нет! Вы отдаете предпочтение мирской жизни,",
   "page": 592,
   "juz": 30
  },
  {
   "ar": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ ١٧",
   "ru": "хотя Последняя жизнь - лучше и дольше.",
   "page": 592,
   "juz": 30
  },
  {
   "ar": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ ١٨",
   "ru": "Воистину, это записано в первых свитках -",
   "page": 592,
   "juz": 30
  },
  {
   "ar": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ ١٩",
   "ru": "свитках Ибрахима (Авраама) и Мусы (Моисея).",
   "page": 592,
   "juz": 30
  }
 ]
}
