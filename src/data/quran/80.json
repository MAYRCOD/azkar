{
 "n": 80,
 "ayahs": [
  {
   "ar": "عَبَسَ وَتَوَلَّىٰٓ ١",
   "ru": "Он нахмурился и отвернулся,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ ٢",
   "ru": "потому что к нему подошел слепой.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ٣",
   "ru": "Откуда тебе знать? Возможно, он бы очистился",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ ٤",
   "ru": "или помянул бы наставление, и поминание принесло бы ему пользу.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ ٥",
   "ru": "Тому, кто решил, что он ни в чем не нуждается,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "فَأَنتَ لَهُۥ تَصَدَّىٰ ٦",
   "ru": "ты уделяешь внимание,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ٧",
   "ru": "Что же будет тебе, если он не очистится?",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ٨",
   "ru": "А того, кто приходит к тебе со рвением",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَهُوَ يَخۡشَىٰ ٩",
   "ru": "и страшится Аллаха,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "فَأَنتَ عَنۡهُ تَلَهَّىٰ ١٠",
   "ru": "ты оставляешь без внимания.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "كـَلَّآ إِنَّهَا تَذۡكِرَةٞ ١١",
   "ru": "Но нет! Это есть Назидание,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "فَمَن شَآءَ ذَكَرَهُۥ ١٢",
   "ru": "и пусть помянет его всякий желающий.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "فِي صُحُفٖ مُّكَرَّمَةٖ ١٣",
   "ru": "Оно записано в свитках почитаемых,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ١٤",
   "ru": "вознесенных и очищенных,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "بِأَيۡدِي سَفَرَةٖ ١٥",
   "ru": "в руках посланцев",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "كِرَامِۭ بَرَرَةٖ ١٦",
   "ru": "благородных и покорных.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ١٧",
   "ru": "Да сгинет человек! Как же он неблагодарен!",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ١٨",
   "ru": "Из чего Он сотворил его?",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩",
   "ru": "Он сотворил его из капли и соразмерил (или предопределил стадии его развития),",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ٢٠",
   "ru": "потом облегчил ему путь,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ٢١",
   "ru": "потом умертвил его и поместил в могилу.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ٢٢",
   "ru": "Потом, когда пожелает, Он воскресит его.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "كـَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ٢٣",
   "ru": "Но нет! Он не выполняет того, что Он приказал ему.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ٢٤",
   "ru": "Пусть посмотрит человек на свое пропитание!",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ٢٥",
   "ru": "Мы проливаем обильные ливни,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ٢٦",
   "ru": "затем рассекаем землю трещинами",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا ٢٧",
   "ru": "и взращиваем на ней зерна,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَعِنَبٗا وَقَضۡبٗا ٢٨",
   "ru": "виноград и люцерну,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَزَيۡتُونٗا وَنَخۡلٗا ٢٩",
   "ru": "маслины и финиковые пальмы,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَحَدَآئِقَ غُلۡبٗا ٣٠",
   "ru": "сады густые (или с могучими деревьями),",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَفَٰكِهَةٗ وَأَبّٗا ٣١",
   "ru": "фрукты и травы",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ٣٢",
   "ru": "на пользу вам и вашей скотине.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ٣٣",
   "ru": "Когда же раздастся Оглушительный глас,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ ٣٤",
   "ru": "в тот день человек бросит своего брата,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَأُمِّهِۦ وَأَبِيهِ ٣٥",
   "ru": "свою мать и своего отца,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَصَٰحِبَتِهِۦ وَبَنِيهِ ٣٦",
   "ru": "свою жену и своих сыновей,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ٣٧",
   "ru": "ибо у каждого человека своих забот будет сполна.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ٣٨",
   "ru": "В тот день одни лица будут сиять,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ٣٩",
   "ru": "смеяться и ликовать.",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ٤٠",
   "ru": "На других же лицах в тот день будет прах,",
   "page": 585,
   "juz": 30
  },
  {
   "ar": "تَرۡهَقُهَا قَتَرَةٌ ٤١",
   "ru": "покрывающий их мраком.",
   "page": 586,
   "juz": 30
  },
  {
   "ar": "أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ ٤٢",
   "ru": "Это будут неверующие грешники.",
   "page": 586,
   "juz": 30
  }
 ]
}
