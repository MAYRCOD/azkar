{"n":114,"ayahs":[{"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ ١","ru":"Скажи: «Прибегаю к защите Господа людей,","page":604,"lines":[12,12],"juz":30},{"ar":"مَلِكِ ٱلنَّاسِ ٢","ru":"Царя людей,","page":604,"lines":[12,12],"juz":30},{"ar":"إِلَٰهِ ٱلنَّاسِ ٣","ru":"Бога людей,","page":604,"lines":[12,13],"juz":30},{"ar":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ ٤","ru":"от зла искусителя отступающего (или сжимающегося) при поминании Аллаха,","page":604,"lines":[13,13],"juz":30},{"ar":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ ٥","ru":"который наущает в груди людей","page":604,"lines":[13,14],"juz":30},{"ar":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ ٦","ru":"и бывает из джиннов и людей».","page":604,"lines":[15,15],"juz":30}]}