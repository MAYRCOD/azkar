 "ayahs": [
  {
   "ar": "بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ١",
   "ru": "Во имя Аллаха, Милостивого, Милосердного!",
   "page": 1,
   "juz": 1
  },
  {
   "ar": "ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ ٢",
   "ru": "Хвала Аллаху, Господу миров,",
   "page": 1,
   "juz": 1
  },
  {
   "ar": "ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ ٣",
   "ru": "Милостивому, Милосердному,",
   "page": 1,
   "juz": 1
  },
  {
   "ar": "مَٰلِكِ يَوۡمِ ٱلدِّينِ ٤",
   "ru": "Властелину Дня воздаяния!",
   "page": 1,
   "juz": 1
  },
  {
   "ar": "إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ ٥",
   "ru": "Тебе одному мы поклоняемся и Тебя одного молим о помощи.",
   "page": 1,
   "juz": 1
  },
  {
   "ar": "ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ ٦",
   "ru": "Веди нас прямым путем,",
   "page": 1,
   "juz": 1
  },
  {
   "ar": "صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ ٧",
   "ru": "путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших.",
