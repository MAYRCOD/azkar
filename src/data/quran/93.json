{
 "n": 93,
 "ayahs": [
  {
   "ar": "وَٱلضُّحَىٰ ١",
   "ru": "Клянусь утром!",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَٱلَّيۡلِ إِذَا سَجَىٰ ٢",
   "ru": "Клянусь ночью, когда она успокаивается (или покрывается мраком)!",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ٣",
   "ru": "Не покинул тебя твой Господь и не возненавидел.",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ٤",
   "ru": "Воистину, будущее для тебя лучше, чем настоящее.",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ٥",
   "ru": "Господь твой непременно одарит тебя, и ты будешь удовлетворен.",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ٦",
   "ru": "Разве Он не нашел тебя сиротой и не дал тебе приют?",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ٧",
   "ru": "Он нашел тебя заблудшим и повел прямым путем.",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ٨",
   "ru": "Он нашел тебя бедным и обогатил.",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ٩",
   "ru": "Посему не притесняй сироту!",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ١٠",
   "ru": "И не гони просящего!",
   "page": 596,
   "juz": 30
  },
  {
   "ar": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ١١",
   "ru": "И возвещай о милости своего Господа.",
   "page": 596,
   "juz": 30
  }
 ]
}
